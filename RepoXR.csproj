<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Collecting Valuables in VR</Description>
        <Version>1.2.3</Version>
        <Authors>DaXcess</Authors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <Title>RepoXR</Title>
        <Copyright>Copyright (c) DaXcess 2026</Copyright>
        <PackageProjectUrl>https://github.com/DaXcess/RepoXR</PackageProjectUrl>
        <RepositoryUrl>https://github.com/DaXcess/RepoXR</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <Nullable>enable</Nullable>
        <PackageId>RepoXR</PackageId>
        <RootNamespace>RepoXR</RootNamespace>
        <TargetFramework>netstandard2.1</TargetFramework>
    </PropertyGroup>
    
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DebugType>embedded</DebugType>
        <NoWarn>1701;1702;8618</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <NoWarn>1701;1702;8618</NoWarn>
      <DebugSymbols>true</DebugSymbols>
      <DebugType>portable</DebugType>
    </PropertyGroup>

    <!--
        R.E.P.O. 0.5.0 port: the game's code, Unity 6, Photon, Steamworks and the XR packages come from your game folder
        (with this fork's all-in-one zip unpacked in it), not from NuGet, which only has R.E.P.O. 0.4.4 and Unity 2022:
            dotnet build RepoXR.sln -c Release -p:GamePath="C:\Program Files (x86)\Steam\steamapps\common\REPO"
        XRDeps: the XR packages built for Unity 6 (BepInEx/plugins/RepoXR/RuntimeDeps of the all-in-one zip).
        See COMPILING.md.
    -->
    <PropertyGroup>
        <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\REPO</GamePath>
        <GameManaged>$(GamePath)/REPO_Data/Managed</GameManaged>
        <XRDeps Condition="'$(XRDeps)' == ''">$(GamePath)/BepInEx/plugins/RepoXR/RuntimeDeps</XRDeps>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="CustomDiscoverStateLib" Version="1.0.1" />
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemDefinitionGroup>
        <Reference>
            <Private>false</Private>
        </Reference>
    </ItemDefinitionGroup>

    <!-- R.E.P.O. 0.5.0 (Unity 6000.3.17f1) from the game folder -->
    <ItemGroup>
        <Reference Include="$(GameManaged)/Assembly-CSharp.dll" Publicize="true" />
        <Reference Include="$(GameManaged)/Assembly-CSharp-firstpass.dll" Publicize="true" />
        <Reference Include="$(GameManaged)/Unity.InputSystem.dll" Publicize="true" />
        <Reference Include="$(GameManaged)/Photon*.dll" Publicize="true" />
        <Reference Include="$(GameManaged)/UnityEngine*.dll" />
        <Reference Include="$(GameManaged)/Unity.*.dll" Exclude="$(GameManaged)/Unity.InputSystem.dll" />
        <Reference Include="$(GameManaged)/Facepunch.Steamworks.Win64.dll" />
        <Reference Include="$(GameManaged)/Newtonsoft.Json.dll" />
        <Reference Include="$(GameManaged)/Klattersynth.dll" />
        <Reference Include="$(GameManaged)/Sirenix.*.dll" />
        <Reference Include="$(XRDeps)/*.dll" Publicize="true" />
    </ItemGroup>

    <Target Name="CheckGameFolder" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(GameManaged)/Assembly-CSharp.dll')"
               Text="R.E.P.O. not found in '$(GamePath)': pass -p:GamePath=&lt;the folder with REPO_Data&gt; (see COMPILING.md)" />
        <Error Condition="!Exists('$(XRDeps)/Unity.XR.OpenXR.dll')"
               Text="The Unity 6 XR packages are not in '$(XRDeps)': unpack this fork's all-in-one zip into the game folder, or pass -p:XRDeps=&lt;its BepInEx/plugins/RepoXR/RuntimeDeps&gt; (see COMPILING.md)" />
    </Target>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE" Pack="true" PackagePath="\" />
        <None Remove="Preload\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="Preload\Preload.cs" />
      <Compile Remove="Preload\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Preload\**" />
    </ItemGroup>
</Project>
